# PDS origin used by the account script and bot; not a secret.
ACCOUNT_PDS=http://localhost:2583
# Handle created locally and used by the bot; not a secret.
ACCOUNT_HANDLE=localdev.test
# Email used only when creating the local account; not a secret.
ACCOUNT_EMAIL=dev@example.com
# Password used to create and authenticate the local account; secret outside local testing.
ACCOUNT_PASSWORD=test-password

# Common OTLP endpoint used by the Go bot for logs, traces, and metrics; not a secret.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTLP transport used by the Go bot; not a secret.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Password for the local PLC PostgreSQL user; secret outside local testing.
PLC_DB_PASSWORD=test-only-plc-password
# Login email for the local pgAdmin UI; not a secret.
PGADMIN_DEFAULT_EMAIL=admin@example.com
# Login password for the local pgAdmin UI; secret outside local testing.
PGADMIN_DEFAULT_PASSWORD=test-only-pgadmin-password

# Public hostname advertised by the local PDS; not a secret.
PDS_HOSTNAME=localhost
# Port on which the PDS listens inside the stack; not a secret.
PDS_PORT=2583
# Enables PDS development behavior required by this isolated stack; not a secret.
PDS_DEV_MODE=true
# PLC directory used by the PDS; keep this local to preserve isolation.
PDS_DID_PLC_URL=http://plc:2582
# Persistent PDS data directory inside the container; not a secret.
PDS_DATA_DIRECTORY=/app/data
# Persistent PDS blob directory inside the container; not a secret.
PDS_BLOBSTORE_DISK_LOCATION=/app/data/blobs

# Private PLC rotation key; secret. Generate independently with: openssl rand -hex 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# PDS token-signing secret; secret. Generate independently with: openssl rand -hex 32
PDS_JWT_SECRET=
# PDS administrative password; secret. Generate independently with: openssl rand -hex 32
PDS_ADMIN_PASSWORD=

# Whether account creation requires an invite; disabled for isolated local use.
PDS_INVITE_REQUIRED=false
# Whether PDS request rate limits are enforced; disabled for isolated local use.
PDS_RATE_LIMITS_ENABLED=false
# Whether PDS SSRF protection is disabled; unsafe outside an isolated environment.
PDS_DISABLE_SSRF_PROTECTION=true

# Enables PDS file logging for local collection; not a secret.
LOG_ENABLED=true
# Minimum PDS log level; not a secret.
LOG_LEVEL=info
# PDS log path on the shared container volume; not a secret.
LOG_DESTINATION=/var/log/pds/pds.log

# Datadog-compatible trace receiver used by the PDS; not a secret.
DD_TRACE_AGENT_URL=http://lgtm:8126
# Service name attached to PDS traces; not a secret.
DD_SERVICE=atproto-pds
# Environment name attached to PDS traces; not a secret.
DD_ENV=test
# Enables the PDS trace instrumentation; not a secret.
DD_TRACE_ENABLED=true
# Fraction of PDS traces sampled, from 0 to 1; not a secret.
DD_TRACE_SAMPLE_RATE=1
